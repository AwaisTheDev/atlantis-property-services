---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
---

<BaseLayout title="Request received" description="Your Atlantis request has been received.">
  <PageBanner title="We’ve got it" image="/images/garden-care.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Thank you. We’ll read what you sent and come back to you. You’ll hear from Atlantis, not from
        anyone else.
      </p>
      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/" label="Back to home" dark />
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  setTimeout(() => {
    window.location.href = "/";
  }, 8000);
</script>
