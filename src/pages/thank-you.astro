---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
---

<BaseLayout title="Request received" description="Your Atlantis request has been received." showMobileCta={false}>
  <PageBanner title="We’ve got your request" image="/images/garden-care.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Atlantis will review what you sent and be in touch. You deal with us — not a list of competing
        providers.
      </p>
      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/" label="Back to home" dark />
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  setTimeout(() => {
    window.location.href = "/";
  }, 8000);
</script>
