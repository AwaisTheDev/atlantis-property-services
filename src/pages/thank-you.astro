---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Request received" description="Your Atlantis request has been received." showMobileCta={false}>
  <section class="page-hero">
    <div class="wrap measure">
      <p class="eyebrow">Thank you</p>
      <h1>We’ve got your request</h1>
      <p>Atlantis will review what you sent and be in touch. You deal with us — not a list of competing providers.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  setTimeout(() => {
    window.location.href = "/";
  }, 8000);
</script>
