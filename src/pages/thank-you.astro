---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
---

<BaseLayout title="Request received" description="Your Atlantis request has been received.">
  <PageBanner title="Request received" image="/images/garden-care.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Thank you. Your request is with the Atlantis office. We will reply to the email or mobile number
        you gave us, either with a price or with one question if a detail is missing.
      </p>
      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/" label="Back to home" dark />
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  setTimeout(() => {
    window.location.href = "/";
  }, 8000);
</script>
