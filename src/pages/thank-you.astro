---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
---

<BaseLayout title="Request received" description="Your Atlantis quote request has been received.">
  <PageBanner title="Thanks — we've received your request." image="/images/garden-care.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        We'll review the details and contact you regarding the quote, timing or anything else we need to clarify.
      </p>
      <p class="page-intro__text">
        For urgent enquiries, you can also call us on <a href="tel:0370239460">03 7023 9460</a>.
      </p>
      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/" label="Back to home" dark />
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  setTimeout(() => {
    window.location.href = "/";
  }, 8000);
</script>
