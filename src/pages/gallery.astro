---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import PageCta from "../components/PageCta.astro";
import { galleryItems, galleryServiceTypes } from "../data/gallery";
---

<BaseLayout
  title="Work across Melbourne"
  description="A look at the kinds of jobs Atlantis coordinates — cleans, gardens, waste, handovers and building support across Melbourne’s inner suburbs."
>
  <PageBanner title="Work across Melbourne" image="/images/services/window-cleaning.jpg" />

  <section class="page-body">
    <div class="wrap">
      <p class="page-intro__text" style="margin-bottom: 2rem;">
        These are the kinds of jobs we arrange every week — not a staged portfolio shoot.
        Send a few photos with your request and we’ll scope the work from there.
      </p>

      <div class="gallery-filter" data-gallery-filter>
        <p class="eyebrow">Filter by category</p>
        <div class="gallery-filter__list" role="group" aria-label="Filter gallery by service type">
          <button type="button" class="gallery-filter__btn is-active" data-filter="all" aria-pressed="true">
            All
          </button>
          {
            galleryServiceTypes.map((type) => (
              <button type="button" class="gallery-filter__btn" data-filter={type} aria-pressed="false">
                {type}
              </button>
            ))
          }
        </div>
      </div>

      <div class="gallery-grid" data-gallery-grid>
        {
          galleryItems.map((item) => (
            <figure class="gallery-item" data-service-type={item.serviceType}>
              <img src={item.src} alt={item.alt} width="1200" height="630" loading="lazy" />
              <figcaption>
                <span class="gallery-item__category">{item.serviceType}</span>
                <span class="gallery-item__caption">{item.caption}</span>
                <span class="gallery-item__note">{item.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="gallery-empty muted" data-gallery-empty hidden>
        No images for this category yet.
      </p>
    </div>
  </section>

  <PageCta
    title="Got a similar job?"
    body="Tell us what you need, add a few photos if you have them, and we’ll come back with next steps."
  />
</BaseLayout>

<script>
  const root = document.querySelector("[data-gallery-filter]");
  const grid = document.querySelector("[data-gallery-grid]");
  const empty = document.querySelector("[data-gallery-empty]");
  if (root && grid) {
    const buttons = root.querySelectorAll("[data-filter]");
    const items = grid.querySelectorAll("[data-service-type]");

    function applyFilter(value) {
      buttons.forEach((btn) => {
        const on = btn.dataset.filter === value;
        btn.classList.toggle("is-active", on);
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });

      let visible = 0;
      items.forEach((item) => {
        const show = value === "all" || item.dataset.serviceType === value;
        item.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      });

      if (empty) empty.toggleAttribute("hidden", visible > 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => applyFilter(btn.dataset.filter));
    });
  }
</script>
