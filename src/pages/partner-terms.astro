---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";

const updated = "16 September 2026";
---

<BaseLayout
  title="Service Partner Terms"
  description="Overview of Atlantis Service Partner Terms for approved providers."
>
  <PageBanner title="Service Partner Terms" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow legal-body">
      <p class="notice">
        Draft framework for launch. Full Partner Terms must be accepted before onboarding is final.
        Last updated {updated}. These terms are separate from the public <a href="/terms">Website Terms</a>.
      </p>

      <h2>Purpose</h2>
      <p>
        Approved partners deliver property work coordinated by {site.name}. Customers deal with Atlantis.
        Partners are not listed on the public site as a directory or marketplace of competing providers.
      </p>

      <h2>Application and approval</h2>
      <ul class="page-points">
        <li>Applications are reviewed. Approval is not guaranteed.</li>
        <li>Approval does not guarantee a minimum volume or frequency of work.</li>
        <li>Atlantis may request further information, licences or insurance documents at any time.</li>
        <li>Client references are not required at application but may be requested later.</li>
      </ul>

      <h2>Verification</h2>
      <p>
        By applying, you agree Atlantis may verify your ABN, licences and insurance, and you declare that
        information and documents supplied are current and accurate. You consent to contact about the
        application and future suitable opportunities.
      </p>

      <h2>Work allocation</h2>
      <p>
        Suitable jobs may later be offered through a private Atlantis system for availability and pricing.
        That workflow is internal to Atlantis and its partners — not a public customer marketplace.
      </p>

      <h2>Standards</h2>
      <ul class="page-points">
        <li>Hold appropriate insurance and any licences required for the work offered.</li>
        <li>Deliver work to a professional standard and communicate promptly on access or delays.</li>
        <li>Do not solicit Atlantis customers away from Atlantis using information gained through jobs.</li>
      </ul>

      <h2>Ending the relationship</h2>
      <p>
        Either party may end the partner relationship subject to completing agreed in-progress jobs and
        any notice period set out in the final signed Partner Terms.
      </p>

      <h2>Contact</h2>
      <p>
        Partner enquiries: <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>

      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/partners" label="Become a service partner" dark />
      </p>
    </div>
  </section>
</BaseLayout>
