---
import BaseLayout from "../layouts/BaseLayout.astro";
import RequestForm from "../components/RequestForm.astro";

const service = Astro.url.searchParams.get("service") ?? "";
const urgent = Astro.url.searchParams.get("urgent") === "1";
const intent = Astro.url.searchParams.get("intent") ?? "request";
---

<BaseLayout
  title="Tell Us What You Need"
  description="Request a property service, quote, or booking from Atlantis. Fast, mobile-first job request."
  showMobileCta={false}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Request</p>
      <h1>Tell us what you need</h1>
      <p class="muted">A short job request — not a generic contact form. You can go back a step at any time.</p>
      <RequestForm urgent={urgent} service={service} intent={intent} />
    </div>
  </section>
</BaseLayout>
