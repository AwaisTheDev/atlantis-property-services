---
// Legacy /request URL — client redirect so query params (service, urgent) are preserved on static hosting.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content="0;url=/contact?tab=request" />
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      params.set("tab", "quote");
      window.location.replace("/contact?" + params.toString());
    </script>
  </head>
  <body>
    <p><a href="/contact?tab=request">Continue to contact / get a quote</a></p>
  </body>
</html>
