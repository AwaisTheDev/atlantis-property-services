---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
---

<BaseLayout title="Cookie notice" description="Cookie and privacy notice for Atlantis Property Services.">
  <PageBanner title="Cookie notice" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow legal-body">
      <p class="notice">
        Legal copy to be supplied. Google Analytics will be added at launch; this notice should then
        describe any cookies used.
      </p>
    </div>
  </section>
</BaseLayout>
