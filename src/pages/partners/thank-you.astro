---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Application received" description="Your Atlantis partner application has been received." showMobileCta={false}>
  <section class="page-hero">
    <div class="wrap measure">
      <p class="eyebrow">Thank you</p>
      <h1>Application received</h1>
      <p>We’ll review your details and documents and contact you about next steps. Approval does not guarantee a set amount of work.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </section>
</BaseLayout>
