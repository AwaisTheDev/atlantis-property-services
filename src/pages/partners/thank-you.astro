---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import ArrowLink from "../../components/ArrowLink.astro";
---

<BaseLayout title="Application received" description="Your Atlantis partner application has been received.">
  <PageBanner title="Application received" image="/images/garden-care.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Thanks. We have received your application. We will review the details and contact you about the
        next step. Approval does not commit Atlantis to a set amount of work.
      </p>
      <p style="margin-top: 2.5rem;">
        <ArrowLink href="/" label="Back to home" dark />
      </p>
    </div>
  </section>
</BaseLayout>
