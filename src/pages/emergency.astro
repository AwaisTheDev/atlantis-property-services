---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Urgent Property Help in Melbourne"
  description="Urgent property help from Atlantis Property Services in Melbourne. Tell us the deadline and we’ll say what we can do, and when."
>
  <PageBanner title="When it can’t wait" image="/images/cta-building.jpg" wide />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Keys due back tomorrow. An inspection in the morning. Something you can’t leave over the
        weekend. Mark the request urgent, tell us the suburb and how we get in, and we’ll say whether
        we can actually get there.
      </p>
      <p class="page-intro__text">
        We still send a price first. If there’s a call-out charge, you’ll hear about it before anyone’s
        in the car.
      </p>

      <div class="emergency-actions">
        <ArrowLink href="/contact?tab=request&urgent=1" label="Start an urgent request" dark />
        {
          site.phone ? (
            <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, "")}`}>
              Call {site.phone}
            </a>
          ) : null
        }
      </div>

      <p class="muted" style="margin-top: 2rem;">
        If it can wait, use the usual
        <a href="/contact?tab=request">request form</a>.
      </p>
    </div>
  </section>
</BaseLayout>
