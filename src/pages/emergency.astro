---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Urgent Help in Melbourne"
  description="Urgent cleaning, maintenance and property help in Melbourne. Tell Atlantis Property Services the deadline and we will confirm what we can do, and when."
>
  <PageBanner title="When the work cannot wait" image="/images/cta-building.jpg" wide />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Some jobs have a deadline a standard booking will miss. The keys may be due back tomorrow, an
        inspection may be set for the morning, or a fault may not be safe to leave over the weekend.
        Send the suburb, the deadline and how we get into the property, and we will tell you whether
        we can attend.
      </p>
      <p class="page-intro__text">
        You still receive a price before the visit. Any fee for attending at short notice is included
        in that price, so you can decide before a vehicle leaves.
      </p>

      <div class="emergency-actions">
        <ArrowLink href="/contact?tab=request&urgent=1" label="Start an urgent request" dark />
        {
          site.phone ? (
            <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, "")}`}>
              Call {site.phone}
            </a>
          ) : null
        }
      </div>

      <p class="muted" style="margin-top: 2rem;">
        If the work can wait, use the standard
        <a href="/contact?tab=request">request form</a>.
      </p>
    </div>
  </section>
</BaseLayout>
