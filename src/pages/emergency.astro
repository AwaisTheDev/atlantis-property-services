---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Urgent Property Service"
  description="Need a property job sorted quickly in Melbourne? Tell Atlantis the deadline and we will confirm what can realistically be arranged, with the price agreed before anyone attends."
>
  <PageBanner title="Need it sorted quickly?" image="/images/cta-building.jpg" wide />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text">
        Some property jobs cannot wait for a standard booking. You might have an inspection tomorrow, keys
        being handed over, rubbish that needs clearing, a property that needs cleaning, or an unexpected
        maintenance issue.
      </p>
      <p class="page-intro__text">Tell Atlantis:</p>
      <ul class="page-points">
        <li>What needs doing</li>
        <li>Where the property is</li>
        <li>When it needs to be completed</li>
        <li>How we can access the property</li>
        <li>Any photographs that help explain the job</li>
      </ul>
      <p class="page-intro__text" style="margin-top: 2rem;">
        We will review the request and let you know what can realistically be arranged. Where additional
        charges apply for urgent or short-notice attendance, they are included in your quote before the
        work proceeds.
      </p>

      <div class="emergency-actions">
        <ArrowLink href="/contact?tab=request&urgent=1" label="Start an Urgent Request" dark />
        {
          site.phone ? (
            <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, "")}`}>
              Prefer to talk? Call {site.phone}
            </a>
          ) : null
        }
      </div>

      <p class="muted" style="margin-top: 2rem;">
        If the work can wait, use the standard
        <a href="/contact?tab=request">quote request</a>.
      </p>
    </div>
  </section>
</BaseLayout>
