---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import RequestForm from "../components/RequestForm.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";

const params = Astro.url.searchParams;
const service = params.get("service") ?? "";
const property = params.get("property") ?? "";
const urgentParam = params.get("urgent");
const urgent = urgentParam === "1" || urgentParam === "true" || urgentParam === "yes";
---

<BaseLayout
  title="Request a Quote"
  description="Request a quote or booking with Atlantis Property Services for cleaning, gardens, windows, waste removal and maintenance across Melbourne’s inner suburbs."
>
  <PageBanner title={urgent ? "An urgent request" : "Tell us what you need"} image="/images/cta-building.jpg" wide />

  <section class="page-body">
    <div class="wrap">
      <div class="contact-layout">
        <aside class="contact-layout__aside">
          <h2 class="contact-layout__heading">Send the job from here</h2>
          <p class="page-intro__text">
            The form is the direct way to ask for a price. If you would rather talk it through, call or
            email and we will take the same details from you.
          </p>
          <div class="contact-rows">
            <div class="contact-row">
              <span class="contact-row__label">Email</span>
              <p class="contact-row__value">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
            {
              site.phone ? (
                <div class="contact-row">
                  <span class="contact-row__label">Phone</span>
                  <p class="contact-row__value">
                    <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
                  </p>
                </div>
              ) : null
            }
            <div class="contact-row">
              <span class="contact-row__label">Service area</span>
              <p class="contact-row__value">{site.serviceArea}</p>
            </div>
          </div>
          <p class="muted contact-details__note">
            The postcode tells us how long the trip is. You do not need to judge the distance yourself before you write.
          </p>
        </aside>

        <div class="contact-layout__main">
          <div class="page-tabs" data-page-tabs>
            <div class="page-tabs__list" role="tablist" aria-label="Contact forms">
              <button
                type="button"
                class="page-tabs__tab is-active"
                role="tab"
                id="tab-request"
                aria-controls="panel-request"
                aria-selected="true"
                data-tab="request"
              >
                Request / book a service
              </button>
              <button
                type="button"
                class="page-tabs__tab"
                role="tab"
                id="tab-contact"
                aria-controls="panel-contact"
                aria-selected="false"
                data-tab="contact"
              >
                Contact
              </button>
            </div>

            <div
              class="page-tabs__panel is-active"
              role="tabpanel"
              id="panel-request"
              aria-labelledby="tab-request"
              data-panel="request"
            >
              <p class="page-intro__text" style="margin-bottom: 0;">
                {
                  urgent
                    ? "This form is marked urgent. Describe the fault, the time it has to be finished, and who can let us in."
                    : "Name the rooms or the areas, and mention anything that affects access, such as a lockbox, a pet or a loading dock."
                }
              </p>
              <RequestForm service={service} property={property} urgent={urgent} />
            </div>

            <div
              class="page-tabs__panel"
              role="tabpanel"
              id="panel-contact"
              aria-labelledby="tab-contact"
              data-panel="contact"
              hidden
            >
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector("[data-page-tabs]");
  if (root) {
    const tabs = root.querySelectorAll("[data-tab]");
    const panels = root.querySelectorAll("[data-panel]");

    function activate(name, updateUrl = true) {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === name;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      panels.forEach((panel) => {
        const on = panel.dataset.panel === name;
        panel.classList.toggle("is-active", on);
        panel.hidden = !on;
      });

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("tab", name);
        window.history.replaceState({}, "", url);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.tab));
    });

    const params = new URLSearchParams(window.location.search);
    const tab = params.get("tab");
    if (tab === "contact" || tab === "request" || tab === "quote") {
      activate(tab === "quote" ? "request" : tab, false);
    }
  }
</script>
