---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import RequestForm from "../components/RequestForm.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";

const params = Astro.url.searchParams;
const service = params.get("service") ?? "";
const property = params.get("property") ?? "";
const urgentParam = params.get("urgent");
const urgent = urgentParam === "1" || urgentParam === "true" || urgentParam === "yes";
const tab = params.get("tab");
const requestHeading = urgent ? "Need it sorted quickly?" : "Tell us what your property needs.";
const contactHeading = "Have a question?";
const bannerTitle = tab === "contact" ? contactHeading : requestHeading;
---

<BaseLayout
  title="Request a Quote"
  description="Tell Atlantis what your property needs. One job or several. Request a quote for cleaning, gardens, maintenance, removals and property support across Melbourne."
>
  <PageBanner title={bannerTitle} titleId="page-title" image="/images/cta-building.jpg" wide />

  <section class="page-body">
    <div class="wrap">
      <div class="contact-layout">
        <aside class="contact-layout__aside">
          <h2 class="contact-layout__heading">Prefer to talk?</h2>
          <p class="page-intro__text">
            One job or several. Send us the details and we will take it from there. Tell us what needs
            doing, where the property is, and when you would ideally like it completed. Photos are welcome
            and can help us understand the job and prepare your quote.
          </p>
          <div class="contact-rows">
            <div class="contact-row">
              <span class="contact-row__label">Email</span>
              <p class="contact-row__value">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
            {
              site.phone ? (
                <div class="contact-row">
                  <span class="contact-row__label">Phone</span>
                  <p class="contact-row__value">
                    <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
                  </p>
                </div>
              ) : null
            }
            <div class="contact-row">
              <span class="contact-row__label">Service area</span>
              <p class="contact-row__value">{site.serviceArea}</p>
            </div>
          </div>
          <p class="muted contact-details__note">
            If you are looking for a quote, use the request form so we have the information needed to help
            you quickly. For general enquiries, partnerships or anything else, use Contact.
          </p>
        </aside>

        <div class="contact-layout__main">
          <div class="page-tabs" data-page-tabs>
            <div class="page-tabs__list" role="tablist" aria-label="Contact forms">
              <button
                type="button"
                class="page-tabs__tab is-active"
                role="tab"
                id="tab-request"
                aria-controls="panel-request"
                aria-selected="true"
                data-tab="request"
              >
                Request a Quote
              </button>
              <button
                type="button"
                class="page-tabs__tab"
                role="tab"
                id="tab-contact"
                aria-controls="panel-contact"
                aria-selected="false"
                data-tab="contact"
              >
                Contact
              </button>
            </div>

            <div
              class="page-tabs__panel is-active"
              role="tabpanel"
              id="panel-request"
              aria-labelledby="tab-request"
              data-panel="request"
            >
              <p class="page-intro__text" style="margin-bottom: 0;">
                {
                  urgent
                    ? "This request is marked urgent. Tell us what needs doing, where the property is, when it has to be finished, and how we can get in."
                    : "Include as much detail as you can. Access notes, such as a lockbox, a pet or a loading dock, help us prepare an accurate quote."
                }
              </p>
              <RequestForm service={service} property={property} urgent={urgent} />
            </div>

            <div
              class="page-tabs__panel"
              role="tabpanel"
              id="panel-contact"
              aria-labelledby="tab-contact"
              data-panel="contact"
              hidden
            >
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector("[data-page-tabs]");
  if (root) {
    const tabs = root.querySelectorAll("[data-tab]");
    const panels = root.querySelectorAll("[data-panel]");

    const pageTitle = document.getElementById("page-title");
    const requestHeading = new URLSearchParams(window.location.search).get("urgent")?.match(/^(1|true|yes)$/)
      ? "Need it sorted quickly?"
      : "Tell us what your property needs.";

    function activate(name, updateUrl = true) {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === name;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      panels.forEach((panel) => {
        const on = panel.dataset.panel === name;
        panel.classList.toggle("is-active", on);
        panel.hidden = !on;
      });
      if (pageTitle) {
        pageTitle.textContent = name === "contact" ? "Have a question?" : requestHeading;
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("tab", name);
        window.history.replaceState({}, "", url);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.tab));
    });

    const params = new URLSearchParams(window.location.search);
    const tab = params.get("tab");
    if (tab === "contact" || tab === "request" || tab === "quote") {
      activate(tab === "quote" ? "request" : tab, false);
    }
  }
</script>
