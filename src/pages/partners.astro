---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import PartnerForm from "../components/PartnerForm.astro";
---

<BaseLayout
  title="Become a Service Partner"
  description="Apply to carry out approved work for Atlantis Property Services in Melbourne. Every application is reviewed. Approval does not guarantee a set volume of work."
>
  <PageBanner title="Become a service partner" image="/images/garden-care.jpg" wide />

  <section class="page-body">
    <div class="wrap">
      <p class="page-intro__text" style="margin-bottom: 2.5rem;">
        Atlantis appoints other businesses to carry out work for our clients, while the client
        relationship stays with us. We are looking for operators who already hold the licences and
        insurance their trade requires, and who can take both single jobs and repeat visits. You will
        not be given a public profile on this website.
      </p>
      <div class="page-split">
        <div>
          <h2 style="margin-top: 0; font-size: clamp(22px, 18px + 0.8vw, 28px);">Before you apply</h2>
          <ul class="page-points">
            <li>Applications are subject to review and approval.</li>
            <li>Atlantis may request extra information or documents.</li>
            <li>Approved partners accept separate <a href="/partner-terms">Service Partner Terms</a> before onboarding is final.</li>
            <li>
              In time, suitable work and pricing will be offered through a private Atlantis system. Partners are not given public profiles.
            </li>
          </ul>
        </div>
        <div>
          <PartnerForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
