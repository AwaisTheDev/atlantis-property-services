---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import PageCta from "../components/PageCta.astro";
import { servicesByGroup } from "../data/services";
---

<BaseLayout
  title="Property Services in Melbourne"
  description="Cleaning, end-of-lease, windows, gardens, waste removal, handyman work and building care from Atlantis Property Services, across Melbourne’s inner suburbs."
>
  <PageBanner title="Property services across Melbourne" image="/images/window-cleaning.jpg" wide />

  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__text">
        The work is grouped below, from cleaning through to the care of a whole building. Open a category
        to see how those jobs are organised, or go to a single service when you already know which one
        the property needs.
      </p>
      <nav class="service-cats" aria-label="Service categories">
        {
          servicesByGroup().map(({ group, slug }) => (
            <a class="service-cats__link" href={`/services/${slug}`}>
              {group}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="page-body page-body--flush-top">
    <div class="wrap">
      {
        servicesByGroup().map(({ group, slug, meta, items }) => (
          <div class="service-group">
            <div class="service-group__head">
              <h2>
                <a href={`/services/${slug}`}>{group}</a>
              </h2>
              <p class="service-group__short muted">{meta.short}</p>
            </div>
            <div class="service-list">
              {items.map((item) => (
                <a href={`/services/${item.id}`}>
                  <div>
                    <h3>{item.name}</h3>
                    <p>{item.short}</p>
                  </div>
                  <svg
                    class="service-list__arrow"
                    width="29"
                    height="29"
                    viewBox="0 0 29 29"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <circle cx="14.5005" cy="14.5005" r="14.5005" fill="#c59c59" />
                    <path
                      d="M12.5698 10.5493L17.4326 14.1965L13.1776 18.4515"
                      stroke="#fff"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <PageCta
    title="The job may sit in more than one group"
    body="Tick every service the visit should cover. We will price them together when they share an address and a date."
  />
</BaseLayout>
