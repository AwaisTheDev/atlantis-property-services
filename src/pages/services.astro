---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import PageCta from "../components/PageCta.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { servicesByGroup } from "../data/services";
---

<BaseLayout
  title="Property Services in Melbourne"
  description="Cleaning, gardening, maintenance, repairs, removals and property preparation from Atlantis Property Services, for homes, businesses and managed properties across Melbourne."
>
  <PageBanner title="Property services without the runaround." image="/images/window-cleaning.jpg" wide />

  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__text">
        Whether you need one service or several jobs coordinated at the same property, Atlantis gives you
        one place to start. Choose the service below, or tell us what needs doing and we will help
        organise the rest.
      </p>
      <nav class="service-cats" aria-label="Service categories">
        {
          servicesByGroup().map(({ group, slug }) => (
            <a class="service-cats__link" href={`/services/${slug}`}>
              {group}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="page-body page-body--flush-top">
    <div class="wrap">
      {
        servicesByGroup().map(({ group, slug, meta, items }) => (
          <div class="service-group">
            <div class="service-group__head">
              <h2>
                <a href={`/services/${slug}`}>{group}</a>
              </h2>
              <p class="service-group__short muted">{meta.short}</p>
            </div>
            <div class="service-list">
              {items.map((item) => (
                <a href={`/services/${item.id}`}>
                  <div>
                    <h3>{item.name}</h3>
                    <p>{item.short}</p>
                  </div>
                  <svg
                    class="service-list__arrow"
                    width="29"
                    height="29"
                    viewBox="0 0 29 29"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <circle cx="14.5005" cy="14.5005" r="14.5005" fill="#c59c59" />
                    <path
                      d="M12.5698 10.5493L17.4326 14.1965L13.1776 18.4515"
                      stroke="#fff"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              ))}
            </div>
            <p style="margin-top: 1.5rem;">
              <ArrowLink href={`/contact?tab=request`} label={meta.ctaLabel} dark />
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <PageCta
    title="One property. Multiple jobs. One call."
    body="If the work sits across more than one group, include every job in the same request."
    label="Request a Quote"
  />
</BaseLayout>
