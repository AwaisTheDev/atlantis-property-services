---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import PageCta from "../components/PageCta.astro";
import { faqs } from "../data/faqs";
---

<BaseLayout title="FAQs"   description="Straight answers on what Atlantis covers in Melbourne, how a quote works, regular visits, and urgent jobs.">
  <PageBanner title="Questions people ask" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text" style="margin-bottom: 2.5rem;">
        Suburbs, prices, regular visits, and what happens after you hit send.
      </p>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <div class="faq-footer">
        <ArrowLink href="/contact?tab=request" label="Request / book a service" dark />
      </div>
    </div>
  </section>

  <PageCta />
</BaseLayout>
