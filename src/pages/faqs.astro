---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import PageCta from "../components/PageCta.astro";
import { faqs } from "../data/faqs";
---

<BaseLayout title="Property Service FAQs" description="Answers on Atlantis property services, quotes, recurring visits and urgent jobs across Melbourne and surrounding areas.">
  <PageBanner title="Frequently asked questions" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text" style="margin-bottom: 2.5rem;">
        These are the questions people ask before they send a job: what Atlantis can organise, who the
        service is for, how a quote is agreed, and what changes when the work is urgent.
      </p>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <div class="faq-footer">
        <ArrowLink href="/contact?tab=request" label="Request a Quote" dark />
      </div>
    </div>
  </section>

  <PageCta
    title="Not sure which service you need?"
    body="Tell us what is happening at the property in your own words. We will help work out what is required, then send a price before any work begins."
  />
</BaseLayout>
