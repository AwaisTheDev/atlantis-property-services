---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ArrowLink from "../components/ArrowLink.astro";
import PageCta from "../components/PageCta.astro";
import { faqs } from "../data/faqs";
---

<BaseLayout title="Property Service FAQs" description="Answers on services, quotes, regular visits and urgent jobs from Atlantis Property Services across Melbourne’s inner suburbs, including Brunswick East.">
  <PageBanner title="Frequently asked questions" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow">
      <p class="page-intro__text" style="margin-bottom: 2.5rem;">
        These are the questions people ask before they send a job: where a property can be, how a price
        is agreed, and what changes when the work is urgent.
      </p>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <div class="faq-footer">
        <ArrowLink href="/contact?tab=request" label="Request / book a service" dark />
      </div>
    </div>
  </section>

  <PageCta
    title="Still deciding which service fits?"
    body="Describe the property in your own words. We will match it to the right work and send a price."
  />
</BaseLayout>
