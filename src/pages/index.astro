---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import SmartImage from "../components/SmartImage.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name} description={site.description} showMobileCta={false}>
  <!-- 1. Homepage banner -->
  <section class="banner banner--homepage">
    <div class="banner__bg" aria-hidden="true">
      <div class="banner__image">
        <SmartImage
          src="/images/hero-property.jpg"
          alt="Melbourne inner-suburban terrace house at dusk"
          width={1600}
          height={900}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="banner__overlay"></div>
    </div>
    <div class="banner__content">
      <div class="wrap">
        <div class="banner__inner">
          <div class="banner__text">
            <h1>Property services in Melbourne — cleaning, gardens, maintenance & more</h1>
          </div>
          <div class="banner__links">
            <ArrowLink href="/contact?tab=request&property=residential" label="Residential" />
            <ArrowLink href="/contact?tab=request&property=commercial" label="Commercial" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Text columns -->
  <section class="section text-columns">
    <div class="wrap">
      <div class="text-columns__inner">
        <div class="text-columns__col text-columns__col--left">
          <h2>One request for the jobs your Melbourne property actually needs</h2>
        </div>
        <div class="text-columns__col text-columns__col--right">
          <div class="text-columns__text">
            <p>
              Atlantis Property Services is a locally based coordinator for homes, apartments, strata and
              commercial sites across Melbourne’s inner suburbs — including Brunswick East and surrounds
              within about 50 km of the CBD.
            </p>
            <p>
              Need a regular clean, end-of-lease handover, window clean, garden tidy, hard waste, handyman
              fix or building support? Send one request. We arrange a suitable approved partner and stay
              your point of contact — not a public marketplace of providers.
            </p>
            <p>
              <strong>You talk to Atlantis. We arrange the work and stay accountable.</strong>
            </p>
          </div>
          <div class="text-columns__links">
            <ArrowLink href="/contact?tab=request" label="Tell us what you need" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section-tint">
    <div class="wrap">
      <p class="eyebrow">How Atlantis works</p>
      <h2>Three steps from request to done</h2>
      <ol class="home-steps">
        {
          site.howItWorks.map((item) => (
            <li class="home-steps__item">
              <span class="home-steps__num" aria-hidden="true">
                {item.step}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p style="margin-top: 2rem;">
        <ArrowLink href="/faqs" label="Read FAQs" dark />
      </p>
    </div>
  </section>

  <!-- 3. Image left + body -->
  <section class="section textbox-image textbox-image--image-left">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <SmartImage
            class="textbox-image__img"
            src="/images/window-cleaning.jpg"
            alt="Window cleaning on a Melbourne apartment balcony"
            width={816}
            height={1090}
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>Built for inner-suburb homes, apartments and commercial sites</h2>
            <p>
              Melbourne properties often juggle access, parking, strata rules and tight handover dates.
              That’s the context we scope into every quote — not a one-size generic job form.
            </p>
            <p>
              Typical requests include residential and commercial cleaning, end-of-lease cleans, window
              cleaning, pressure washing, gardening, rubbish and hard waste, painting, fence repairs,
              handyman work, pest control, staging and strata support.
            </p>
            <p>
              Browse the <a href="/services">full services list</a>, or start a request with your postcode
              and a few photos so we can quote accurately.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Why Atlantis -->
  <section class="section textbox-image textbox-image--image-right">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <SmartImage
            class="textbox-image__img"
            src="/images/garden-care.jpg"
            alt="Tidy Melbourne backyard after garden care"
            width={816}
            height={1090}
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>Why owners and managers use Atlantis</h2>
            <ul class="home-why">
              {
                site.why.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <span>{item.body}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="textbox-image__buttons">
            <ArrowLink href="/services" label="See all services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Words from clients -->
  <section class="section testimonial">
    <div class="wrap">
      <div class="testimonial__card" data-testimonial-banner>
        <p class="testimonial__eyebrow">From Melbourne customers</p>
        {
          site.testimonials.map((item, index) => (
            <div class:list={["testimonial__slide", { active: index === 0 }]} data-slide={index}>
              <div class="testimonial__row">
                <div class="testimonial__quote">
                  <p>“{item.quote}”</p>
                </div>
                <span class="testimonial__divider" aria-hidden="true" />
                <div class="testimonial__author">
                  <p class="testimonial__name">{item.name}</p>
                  <p class="testimonial__role">{item.company}</p>
                </div>
              </div>
            </div>
          ))
        }
        {
          site.testimonials.length > 1 && (
            <div class="testimonial__nav" aria-label="Testimonial navigation">
              {site.testimonials.map((_, index) => (
                <button
                  type="button"
                  class:list={["testimonial__dot", { active: index === 0 }]}
                  data-goto={index}
                  aria-label={`Show testimonial ${index + 1}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 6. Closing CTA -->
  <section class="cta">
    <div class="cta__bg" aria-hidden="true">
      <div class="cta__image">
        <SmartImage src="/images/cta-building.jpg" alt="" width={1600} height={900} loading="lazy" />
      </div>
      <div class="cta__overlay"></div>
    </div>
    <div class="cta__content">
      <div class="wrap">
        <div class="cta__inner">
          <div class="cta__text">
            <h2>Need property work in Melbourne’s inner suburbs?</h2>
            <p>
              Send a request with your postcode and what needs doing — we’ll come back with next steps
              and a quote.
            </p>
          </div>
          <div class="cta__buttons">
            <ArrowLink href="/contact?tab=request" label="Request / book a service" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const banner = document.querySelector("[data-testimonial-banner]");
  if (banner) {
    const slides = banner.querySelectorAll("[data-slide]");
    const dots = banner.querySelectorAll("[data-goto]");
    let current = 0;

    function show(index) {
      current = index;
      slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => show(Number(dot.dataset.goto)));
    });

    if (slides.length > 1) {
      setInterval(() => show((current + 1) % slides.length), 7000);
    }
  }
</script>
