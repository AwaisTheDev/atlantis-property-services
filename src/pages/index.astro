---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name} description={site.description}>
  <!-- 1. Homepage banner -->
  <section class="banner banner--homepage">
    <div class="banner__bg" aria-hidden="true">
      <div class="banner__image">
        <img
          src="/images/hero-property.jpg"
          alt="Melbourne suburban property at dusk"
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </div>
      <div class="banner__overlay"></div>
    </div>
    <div class="banner__content">
      <div class="wrap">
        <div class="banner__inner">
          <div class="banner__text">
            <h1>Melbourne property services for homes, apartments and commercial sites</h1>
          </div>
          <div class="banner__links">
            <ArrowLink href="/contact?tab=request&property=residential" label="Residential" />
            <ArrowLink href="/contact?tab=request&property=commercial" label="Commercial" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. One point of contact -->
  <section class="section text-columns">
    <div class="wrap">
      <div class="text-columns__inner">
        <div class="text-columns__col text-columns__col--left">
          <h2>One point of contact across the work a property needs</h2>
        </div>
        <div class="text-columns__col text-columns__col--right">
          <div class="text-columns__text">
            <p>
              A property rarely needs just one trade. Atlantis looks after the work that keeps Melbourne
              homes, apartments and commercial sites in order: cleaning, gardens, glass, waste, and the
              smaller repairs that sit between them.
            </p>
            <p>
              From Brunswick East through the inner suburbs, you speak with us. We price the job, book it,
              and stay with it until it is finished.
            </p>
          </div>
          <div class="text-columns__links">
            <ArrowLink href="/services" label="Full list of services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Image left + body -->
  <section class="section textbox-image textbox-image--image-left">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/window-cleaning.jpg"
            alt="Window cleaning on a Melbourne apartment building"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>The properties we look after play a crucial role in how people live, work and feel at home.</h2>
            <p>
              A terrace, a strata apartment and a small commercial tenancy are not the same job. Access,
              parking and the date it has to be ready all change the quote. We price with that in mind.
            </p>
            <p>
              A window clean and a vacate can sit on one request. So can a garden tidy ahead of an
              inspection. You hear from Atlantis, not from a chain of different companies.
            </p>
            <p>
              If the timing is tight, say so. We’ll tell you what can be done, and when.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Inspired by simplicity -->
  <section class="section textbox-image textbox-image--image-right">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/garden-care.jpg"
            alt="Garden and outdoor care at a Melbourne home"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>Inspired by simplicity.</h2>
            <p>
              You describe the property and the result you want. We send a quote. If it suits, we book the
              work. There is no list of providers to compare, and no obligation to proceed.
            </p>
            <p>
              A few photos help, especially for waste, gardens and anything that is hard to describe. Where
              an emergency call-out fee applies, we agree it before anyone arrives.
            </p>
            <p>
              The people on site are approved and insured. The name on the booking is ours.
            </p>
          </div>
          <div class="textbox-image__buttons">
            <ArrowLink href="/services" label="See all services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Words from clients -->
  <section class="section testimonial">
    <div class="wrap">
      <div class="testimonial__card" data-testimonial-banner>
        <p class="testimonial__eyebrow">Words from clients</p>
        {
          site.testimonials.map((item, index) => (
            <div class:list={["testimonial__slide", { active: index === 0 }]} data-slide={index}>
              <div class="testimonial__row">
                <div class="testimonial__quote">
                  <p>“{item.quote}”</p>
                </div>
                <span class="testimonial__divider" aria-hidden="true" />
                <div class="testimonial__author">
                  <p class="testimonial__name">{item.name}</p>
                  <p class="testimonial__role">{item.company}</p>
                </div>
              </div>
            </div>
          ))
        }
        {
          site.testimonials.length > 1 && (
            <div class="testimonial__nav" aria-label="Testimonial navigation">
              {site.testimonials.map((_, index) => (
                <button
                  type="button"
                  class:list={["testimonial__dot", { active: index === 0 }]}
                  data-goto={index}
                  aria-label={`Show testimonial ${index + 1}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 6. Closing CTA -->
  <section class="cta">
    <div class="cta__bg" aria-hidden="true">
      <div class="cta__image">
        <img src="/images/cta-building.jpg" alt="" width="1600" height="900" loading="lazy" />
      </div>
      <div class="cta__overlay"></div>
    </div>
    <div class="cta__content">
      <div class="wrap">
        <div class="cta__inner">
          <div class="cta__text">
            <h2>Let’s get it done.</h2>
            <p>
              Send a few details and we’ll come back with a quote for work across Melbourne’s inner suburbs.
            </p>
          </div>
          <div class="cta__buttons">
            <ArrowLink href="/contact?tab=request" label="Contact us" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const banner = document.querySelector("[data-testimonial-banner]");
  if (banner) {
    const slides = banner.querySelectorAll("[data-slide]");
    const dots = banner.querySelectorAll("[data-goto]");
    let current = 0;

    function show(index) {
      current = index;
      slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => show(Number(dot.dataset.goto)));
    });

    if (slides.length > 1) {
      setInterval(() => show((current + 1) % slides.length), 7000);
    }
  }
</script>
