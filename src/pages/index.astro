---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";
---

<BaseLayout title="Melbourne Property Services" description={site.description}>
  <!-- 1. Homepage banner -->
  <section class="banner banner--homepage">
    <div class="banner__bg" aria-hidden="true">
      <div class="banner__image">
        <img
          src="/images/hero-property.jpg"
          alt="Melbourne suburban property at dusk"
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </div>
      <div class="banner__overlay"></div>
    </div>
    <div class="banner__content">
      <div class="wrap">
        <div class="banner__inner">
          <div class="banner__text">
            <h1>Melbourne property services for homes, apartments and commercial buildings</h1>
          </div>
          <div class="banner__links">
            <ArrowLink href="/contact?tab=request&property=residential" label="Residential" />
            <ArrowLink href="/contact?tab=request&property=commercial" label="Commercial" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. One point of contact -->
  <section class="section text-columns">
    <div class="wrap">
      <div class="text-columns__inner">
        <div class="text-columns__col text-columns__col--left">
          <h2>One company for the jobs a property collects at once</h2>
        </div>
        <div class="text-columns__col text-columns__col--right">
          <div class="text-columns__text">
            <p>
              Most homes and buildings need more than a single trade. A vacate might still need a proper
              bathroom clean and a door that will not latch. An open inspection might need the windows
              finished and the garden cut before the photographer arrives. Hard rubbish can still be in
              the garage when the rest of the work has already been booked.
            </p>
            <p>
              Atlantis Property Services handles that mix from Brunswick East, for properties within about
              50 kilometres of the Melbourne CBD. You speak to us about the job, the quote comes from us,
              and you call us if something needs attention afterwards.
            </p>
          </div>
          <div class="text-columns__links">
            <ArrowLink href="/services" label="View all services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Image left + body -->
  <section class="section textbox-image textbox-image--image-left">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/window-cleaning.jpg"
            alt="Window cleaning on a Melbourne apartment building"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>Access and timing belong in the quote</h2>
            <p>
              A single-front terrace, a third-floor apartment and a shopfront on Sydney Road are priced
              differently, because the way we get in is part of the work. Tell us about lift bookings,
              where a van can stop, and any owners corporation rule that limits balcony access.
            </p>
            <p>
              When several tasks have to land on the same morning, put them in the one request. We will
              tell you whether that morning is realistic before we schedule anyone.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Quote before booking -->
  <section class="section textbox-image textbox-image--image-right">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/garden-care.jpg"
            alt="Garden and outdoor care at a Melbourne home"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>You approve the price before we attend</h2>
            <p>
              Describe the property and the work in plain sentences. Add photographs when the job is a
              garden, a load of rubbish, or a fault that is awkward to explain. We reply with a price and
              a scope, and the work starts only after you accept that quote.
            </p>
            <p>
              Urgent work is quoted the same way. If a call-out fee applies, it is written into the quote
              before anyone travels. The people who attend are insured, and the booking stays with
              Atlantis.
            </p>
          </div>
          <div class="textbox-image__buttons">
            <ArrowLink href="/services" label="See all services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Words from clients -->
  <section class="section testimonial">
    <div class="wrap">
      <div class="testimonial__card" data-testimonial-banner>
        <p class="testimonial__eyebrow">Words from clients</p>
        {
          site.testimonials.map((item, index) => (
            <div class:list={["testimonial__slide", { active: index === 0 }]} data-slide={index}>
              <div class="testimonial__row">
                <div class="testimonial__quote">
                  <p>“{item.quote}”</p>
                </div>
                <span class="testimonial__divider" aria-hidden="true" />
                <div class="testimonial__author">
                  <p class="testimonial__name">{item.name}</p>
                  <p class="testimonial__role">{item.company}</p>
                </div>
              </div>
            </div>
          ))
        }
        {
          site.testimonials.length > 1 && (
            <div class="testimonial__nav" aria-label="Testimonial navigation">
              {site.testimonials.map((_, index) => (
                <button
                  type="button"
                  class:list={["testimonial__dot", { active: index === 0 }]}
                  data-goto={index}
                  aria-label={`Show testimonial ${index + 1}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 6. Closing CTA -->
  <section class="cta">
    <div class="cta__bg" aria-hidden="true">
      <div class="cta__image">
        <img src="/images/cta-building.jpg" alt="" width="1600" height="900" loading="lazy" />
      </div>
      <div class="cta__overlay"></div>
    </div>
    <div class="cta__content">
      <div class="wrap">
        <div class="cta__inner">
          <div class="cta__text">
            <h2>Start with the property</h2>
            <p>
              If you already know the address and the tasks, send them through and we will price the visit.
            </p>
          </div>
          <div class="cta__buttons">
            <ArrowLink href="/contact?tab=request" label="Request a quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const banner = document.querySelector("[data-testimonial-banner]");
  if (banner) {
    const slides = banner.querySelectorAll("[data-slide]");
    const dots = banner.querySelectorAll("[data-goto]");
    let current = 0;

    function show(index) {
      current = index;
      slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => show(Number(dot.dataset.goto)));
    });

    if (slides.length > 1) {
      setInterval(() => show((current + 1) % slides.length), 7000);
    }
  }
</script>
