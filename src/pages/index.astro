---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../data/site";

const homeServices = [
  {
    title: "Cleaning",
    body: "Reliable cleaning for homes, businesses, apartments and shared spaces, from regular cleaning to deep cleans, end-of-lease and builders cleans.",
    href: "/services/cleaning-hygiene",
    label: "Explore Cleaning",
  },
  {
    title: "Gardens and outdoor care",
    body: "Gardening, landscaping, pressure washing, exterior cleaning and general outdoor property care.",
    href: "/services/property-exterior-care",
    label: "Explore Outdoor Services",
  },
  {
    title: "Maintenance and repairs",
    body: "Painting, handyman services, fence repairs and general property maintenance, including the smaller jobs that do not need a separate trade each.",
    href: "/services/property-exterior-care",
    label: "Explore Maintenance",
  },
  {
    title: "Rubbish and removal",
    body: "From unwanted furniture and hard waste to a complete clean-out of a house, apartment or garage.",
    href: "/services/waste-removal",
    label: "Explore Removal Services",
  },
  {
    title: "Moving and property preparation",
    body: "Cleaning, repairs, presentation and other services coordinated around moving, leasing or selling a property.",
    href: "/services/move-in-move-out",
    label: "Explore Property Preparation",
  },
  {
    title: "Building and facilities",
    body: "Ongoing cleaning, maintenance and property support for apartment buildings, owners corporations and commercial properties.",
    href: "/services/building-facilities",
    label: "Explore Building Services",
  },
];
---

<BaseLayout title="Melbourne Property Services" description={site.description}>
  <section class="banner banner--homepage">
    <div class="banner__bg" aria-hidden="true">
      <div class="banner__image">
        <img
          src="/images/hero-property.jpg"
          alt="Melbourne suburban property at dusk"
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </div>
      <div class="banner__overlay"></div>
    </div>
    <div class="banner__content">
      <div class="wrap">
        <div class="banner__inner">
          <div class="banner__text">
            <h1>Property services. Made simple.</h1>
            <p class="banner__lead">
              Cleaning, gardening, maintenance, repairs and more, organised through one reliable point of
              contact. From a single job to ongoing property care, tell us what you need and Atlantis will
              take care of the rest. We support residential and commercial properties, property managers and
              owners corporations.
            </p>
          </div>
          <div class="banner__links">
            <ArrowLink href="/contact?tab=request" label="Request a Quote" />
            <ArrowLink href="/services" label="Explore Our Services" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section text-columns">
    <div class="wrap">
      <div class="text-columns__inner">
        <div class="text-columns__col text-columns__col--left">
          <h2>Everything your property needs. All in one place.</h2>
        </div>
        <div class="text-columns__col text-columns__col--right">
          <div class="text-columns__text">
            <p>
              Looking after a property can mean dealing with cleaners, gardeners, handymen, maintenance
              providers and several trades. Atlantis makes that simpler. We bring a wide range of property
              services together through one point of contact, so the work is easier to organise, coordinate
              and finish.
            </p>
            <p>
              Homes, investment properties, apartment buildings and commercial premises rarely need just one
              type of service. Gardens need maintaining. Things break. Rubbish needs removing. Tenants move
              in and out. Whether it is one job, several at once, or ongoing care, you tell us what the
              property needs and we take it from there.
            </p>
          </div>
          <div class="text-columns__links">
            <ArrowLink href="/services" label="Explore Our Services" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint home-services">
    <div class="wrap">
      <h2>Our services</h2>
      <p class="page-intro__text home-services__intro">
        Choose a starting point below, or tell us what needs doing and we will help organise the rest.
        More than one job at the same property can go on a single request.
      </p>
      <ul class="home-services__grid">
        {
          homeServices.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ArrowLink href={item.href} label={item.label} dark />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="text-columns__inner">
        <div class="text-columns__col text-columns__col--left">
          <h2>One call. One point of contact.</h2>
        </div>
        <div class="text-columns__col text-columns__col--right">
          <div class="text-columns__text">
            <p>
              You should not have to spend the day searching for a different person every time something
              needs doing. With Atlantis, you tell us what the property needs. We organise the right
              service, coordinate the work, and remain your point of contact throughout.
            </p>
          </div>
        </div>
      </div>
      <ol class="home-steps">
        {
          site.howItWorks.map((item) => (
            <li class="home-steps__item">
              <span class="home-steps__num">{item.step}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="home-section__action">
        <ArrowLink href="/contact?tab=request" label="Request a Quote" dark />
      </p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <h2>Why Atlantis?</h2>
      <ul class="home-why">
        {
          site.why.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section textbox-image textbox-image--image-left">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/window-cleaning.jpg"
            alt="Window cleaning on a Melbourne apartment building"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <p class="eyebrow">Managing more than one property?</p>
            <h2>Make property maintenance easier to manage.</h2>
            <p>
              Atlantis provides one point of contact for multiple property services across residential and
              commercial properties. We can coordinate ongoing work and one-off jobs for property managers,
              landlords, owners corporations, strata managers, commercial owners, short-stay operators and
              homeowners.
            </p>
            <p>Instead of managing several providers yourself, send the work to Atlantis.</p>
          </div>
          <div class="textbox-image__buttons">
            <ArrowLink href="/contact?tab=contact" label="Talk to Atlantis" dark />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section textbox-image textbox-image--image-right">
    <div class="wrap">
      <div class="textbox-image__inner">
        <div class="textbox-image__media">
          <img
            class="textbox-image__img"
            src="/images/garden-care.jpg"
            alt="Garden and outdoor care at a Melbourne home"
            width="816"
            height="1090"
            loading="lazy"
          />
        </div>
        <div class="textbox-image__body">
          <div class="textbox-image__text">
            <h2>Need something done urgently?</h2>
            <p>
              Sometimes property work cannot wait. If you are dealing with an urgent clean, a last-minute
              inspection, a property handover, a removal or a maintenance issue, contact Atlantis and tell
              us your deadline.
            </p>
            <p>
              We will let you know what can realistically be arranged. Where a short-notice attendance
              changes the price, that is included in the quote before anyone travels.
            </p>
          </div>
          <div class="textbox-image__buttons">
            <ArrowLink href="/contact?tab=request&urgent=1" label="Request Urgent Service" dark />
            {
              site.phone ? (
                <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, "")}`}>
                  Call {site.phone}
                </a>
              ) : null
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__bg" aria-hidden="true">
      <div class="cta__image">
        <img src="/images/cta-building.jpg" alt="" width="1600" height="900" loading="lazy" />
      </div>
      <div class="cta__overlay"></div>
    </div>
    <div class="cta__content">
      <div class="wrap">
        <div class="cta__inner">
          <div class="cta__text">
            <h2>One property. Multiple jobs. One call.</h2>
            <p>Whatever your property needs, start with Atlantis. Tell us what needs doing and we will take it from there.</p>
          </div>
          <div class="cta__buttons">
            <ArrowLink href="/contact?tab=request" label="Request a Quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
