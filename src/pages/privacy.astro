---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import { site } from "../data/site";
---

<BaseLayout title="Privacy Policy" description="Privacy information for Atlantis Property Services.">
  <PageBanner title="Privacy Policy" image="/images/interior-clean.jpg" />

  <section class="page-body">
    <div class="wrap page-body--narrow legal-body">
      <p class="notice">
        Legal copy to be supplied and approved. This page is a structure placeholder, not a binding
        policy.
      </p>
      <p>
        {site.name} will use this page to explain how customer requests and partner applications
        (including contact details, postcodes, job descriptions, and uploaded files) are collected and
        stored.
      </p>
    </div>
  </section>
</BaseLayout>
