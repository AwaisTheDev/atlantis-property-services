---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Privacy Policy" description="Privacy information for Atlantis Property Services.">
  <section class="page-hero">
    <div class="wrap measure">
      <h1>Privacy Policy</h1>
      <p class="notice">Legal copy to be supplied and approved. This page is a structure placeholder, not a binding policy.</p>
      <p class="muted">
        {site.name} will use this page to explain how customer requests and partner applications
        (including contact details, postcodes, job descriptions, and uploaded files) are collected and stored.
      </p>
    </div>
  </section>
</BaseLayout>
