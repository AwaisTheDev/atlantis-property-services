---
import { formServiceId, servicesForForms } from "../data/services";
import { customerTypes, frequencies } from "../data/site";

type Props = {
  service?: string;
  property?: string;
  urgent?: boolean;
};

const { service = "", property = "", urgent = false } = Astro.props;
const selected = service ? service.split(",").filter(Boolean).map((id) => formServiceId(id)) : [];
const propertyType =
  property.toLowerCase() === "commercial"
    ? "Commercial"
    : property.toLowerCase() === "residential"
      ? "Residential"
      : "";
---

<form id="request-form" novalidate>
  <input type="hidden" name="intent" value="request" />
  <input type="hidden" name="formType" value="Customer request" />
  <div class="progress" aria-hidden="true">
    <span class="active" data-bar="1"></span>
    <span data-bar="2"></span>
    <span data-bar="3"></span>
  </div>
  <p class="muted" id="step-label">Step 1 of 3 — What do you need?</p>
  <p class="error" id="form-error" hidden></p>

  <section class="step active" data-step="1">
    <h2>What do you need?</h2>
    <p class="muted">Select everything you need completed at this property.</p>
    <fieldset>
      <legend class="eyebrow">Services required</legend>
      <div class="checkbox-grid">
        {
          servicesForForms().map((item) => (
            <label>
              <input type="checkbox" name="services" value={item.id} checked={selected.includes(item.id)} />
              {item.name}
            </label>
          ))
        }
      </div>
    </fieldset>
    <label>
      One-off or recurring?
      <select name="cadence" required>
        <option value="one-off">One-off</option>
        <option value="recurring">Recurring</option>
      </select>
    </label>
    <label id="frequency-field" hidden>
      How often?
      <select name="frequency">
        {frequencies.map((f) => <option value={f}>{f}</option>)}
      </select>
    </label>
    <label class="urgent-flag">
      <input type="checkbox" name="urgent" value="yes" checked={urgent} />
      <span>
        <strong>This job is urgent</strong>
        <span class="muted">Select this if the work needs to be completed urgently or within a specific short timeframe.</span>
      </span>
    </label>
  </section>

  <section class="step" data-step="2">
    <h2>Tell us about the job</h2>
    <label>
      What needs doing?
      <textarea name="description" required minlength="10" placeholder="Tell us what you need in your own words. Include as much detail as you can."></textarea>
    </label>
    <label>
      Preferred date or timeframe
      <input type="text" name="preferredTime" placeholder="e.g. Friday morning, sometime next week, before 12 October" />
    </label>
    <label>
      Upload photos or files
      <input type="file" name="files" multiple accept="image/*,.pdf" />
      <span class="muted">Photos can help us understand the work and prepare your quote.</span>
    </label>
  </section>

  <section class="step" data-step="3">
    <h2>Your details</h2>
    <label>
      Name
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      Mobile
      <input type="tel" name="mobile" required autocomplete="tel" />
    </label>
    <label>
      Email
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label>
      Property postcode
      <input type="text" name="postcode" required inputmode="numeric" pattern="[0-9]{4}" maxlength="4" />
    </label>
    <label>
      Property type
      <select name="propertyType" required>
        <option value="Residential" selected={propertyType === "Residential" || !propertyType}>Residential</option>
        <option value="Commercial" selected={propertyType === "Commercial"}>Commercial</option>
      </select>
    </label>
    <label>
      I am a
      <select name="customerType" required>
        {customerTypes.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <label>
      Preferred contact
      <select name="contactMethod" required>
        <option value="Phone">Phone</option>
        <option value="SMS">SMS</option>
        <option value="Email">Email</option>
      </select>
    </label>
    <p class="muted">Enter the property postcode and we will confirm availability for that location.</p>
  </section>

  <div class="form-actions">
    <button class="btn btn-ghost" type="button" id="back-btn" hidden>Back</button>
    <button class="btn btn-primary" type="button" id="next-btn">Continue</button>
    <button class="btn btn-primary" type="submit" id="submit-btn" hidden>Request My Quote</button>
  </div>
</form>

<script>
  import { submitSiteForm } from "../lib/formSubmit";

  const form = document.getElementById("request-form") as HTMLFormElement | null;
  if (form) {
    let step = 1;
    const steps = form.querySelectorAll<HTMLElement>(".step");
    const bars = form.querySelectorAll<HTMLElement>("[data-bar]");
    const back = document.getElementById("back-btn") as HTMLButtonElement;
    const next = document.getElementById("next-btn") as HTMLButtonElement;
    const submit = document.getElementById("submit-btn") as HTMLButtonElement;
    const err = document.getElementById("form-error") as HTMLElement;
    const label = document.getElementById("step-label") as HTMLElement;
    const cadence = form.querySelector<HTMLSelectElement>('[name="cadence"]');
    const freq = document.getElementById("frequency-field") as HTMLElement;

    const labels = [
      "Step 1 of 3 — What do you need?",
      "Step 2 of 3 — Tell us about the job",
      "Step 3 of 3 — Your details",
    ];

    function showError(message: string) {
      err.hidden = !message;
      err.textContent = message;
    }

    function render() {
      steps.forEach((el) => el.classList.toggle("active", Number(el.dataset.step) === step));
      bars.forEach((el) => el.classList.toggle("active", Number(el.dataset.bar) <= step));
      back.hidden = step === 1;
      next.hidden = step === 3;
      submit.hidden = step !== 3;
      label.textContent = labels[step - 1];
      showError("");
    }

    cadence?.addEventListener("change", () => {
      const recurring = cadence.value === "recurring";
      freq.hidden = !recurring;
    });

    function stepValid() {
      const current = form.querySelector<HTMLElement>(`.step[data-step="${step}"]`);
      if (!current) return false;
      if (step === 1) {
        const checked = form.querySelectorAll<HTMLInputElement>('[name="services"]:checked');
        if (!checked.length) {
          showError("Select at least one service.");
          return false;
        }
      }
      const fields = current.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        "input, select, textarea",
      );
      for (const field of fields) {
        if (field.closest("[hidden]")) continue;
        if (!field.checkValidity()) {
          field.reportValidity();
          return false;
        }
      }
      return true;
    }

    next.addEventListener("click", () => {
      if (!stepValid()) return;
      step += 1;
      render();
    });
    back.addEventListener("click", () => {
      step -= 1;
      render();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!stepValid()) return;
      submit.disabled = true;
      const urgent = form.querySelector<HTMLInputElement>('[name="urgent"]')?.checked;
      const email = form.querySelector<HTMLInputElement>('[name="email"]')?.value;
      const result = await submitSiteForm(form, {
        subject: urgent
          ? "URGENT — Atlantis customer request"
          : "Atlantis customer request",
        replyTo: email,
      });
      if (!result.ok) {
        submit.disabled = false;
        showError(result.message || "Could not send. Please try again.");
        return;
      }
      window.location.href = "/thank-you";
    });

    const params = new URLSearchParams(window.location.search);
    const servicesParam = params.get("service");
    const serviceAliases: Record<string, string> = {
      "property-presentation": "property-preparation",
    };
    if (servicesParam) {
      servicesParam.split(",").forEach((id) => {
        const value = serviceAliases[id] ?? id;
        const box = form.querySelector<HTMLInputElement>(`[name="services"][value="${value}"]`);
        if (box) box.checked = true;
      });
    }
    const propertyParam = params.get("property")?.toLowerCase();
    if (propertyParam === "residential" || propertyParam === "commercial") {
      const select = form.querySelector<HTMLSelectElement>('[name="propertyType"]');
      if (select) {
        select.value = propertyParam === "commercial" ? "Commercial" : "Residential";
      }
    }
    const urgentParam = params.get("urgent");
    if (urgentParam === "1" || urgentParam === "true" || urgentParam === "yes") {
      const box = form.querySelector<HTMLInputElement>('[name="urgent"]');
      if (box) box.checked = true;
    }

    render();
  }
</script>
