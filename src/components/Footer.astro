---
import { site } from "../data/site";

const year = new Date().getFullYear();
const copyright = site.copyright.replace("{year}", String(year));

const socialLinks = [
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.facebook, label: "Facebook" },
  { href: site.social.instagram, label: "Instagram" },
].filter((link) => Boolean(link.href));
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <img class="footer-logo" src="/logo-on-dark.svg" alt="Atlantis Property Services" width="493" height="346" />
      <p class="muted">{site.tagline}</p>
      {
        socialLinks.length ? (
          <nav class="footer-social" aria-label="Social media">
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))}
          </nav>
        ) : (
          <p class="muted footer-social-note">LinkedIn · Facebook · Instagram — profiles coming soon</p>
        )
      }
    </div>
    <div>
      <p class="eyebrow">Contact</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {
        site.phone ? (
          <p>
            <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
          </p>
        ) : null
      }
      <p class="muted">{site.serviceArea}</p>
    </div>
    <div>
      <p class="eyebrow">Site</p>
      <p>
        <a href="/services">Services</a><br />
        <a href="/gallery">Gallery</a><br />
        <a href="/faqs">FAQs</a><br />
        <a href="/partners">Become a Service Partner</a><br />
        <a href="/emergency">Emergency / Urgent</a><br />
        <a href="/contact">Contact</a><br />
        <a href="/privacy">Privacy</a>
      </p>
    </div>
  </div>
  <div class="wrap legal-links">
    <span class="muted">{copyright}</span>
    <a href="/terms">Website Terms</a>
    <a href="/partner-terms">Partner Terms</a>
    <a href="/cookies">Cookie notice</a>
  </div>
  <div class="wrap credit-line">
    <span class="muted">
      Web development and Design by
      <a href="https://www.atlanticmediagroup.com.au" target="_blank" rel="noopener noreferrer"
        >www.atlanticmediagroup.com.au</a
      >
    </span>
  </div>
</footer>
