---
import ArrowLink from "./ArrowLink.astro";

type Props = {
  title?: string;
  body?: string;
  href?: string;
  label?: string;
  image?: string;
};

const {
  title = "Ready to request a quote?",
  body = "Send the address, the work required, and the postcode. We will reply with a price.",
  href = "/contact?tab=request",
  label = "Request / book a service",
  image = "/images/cta-building.jpg",
} = Astro.props;
---

<section class="cta">
  <div class="cta__bg" aria-hidden="true">
    <div class="cta__image">
      <img src={image} alt="" width="1600" height="900" loading="lazy" />
    </div>
    <div class="cta__overlay"></div>
  </div>
  <div class="cta__content">
    <div class="wrap">
      <div class="cta__inner">
        <div class="cta__text">
          <h2>{title}</h2>
          <p>{body}</p>
        </div>
        <div class="cta__buttons">
          <ArrowLink href={href} label={label} />
        </div>
      </div>
    </div>
  </div>
</section>
