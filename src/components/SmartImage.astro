---
type Props = {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
};

const { src, alt, width, height, loading = "lazy", fetchpriority, class: className } = Astro.props;
const webpSrc = src.replace(/\.(jpe?g|png)$/i, ".webp");
const hasWebpCandidate = /\.(jpe?g|png)$/i.test(src);
---

{
  hasWebpCandidate ? (
    <picture>
      <source srcset={webpSrc} type="image/webp" />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={fetchpriority}
        class={className}
        decoding="async"
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
      decoding="async"
    />
  )
}
